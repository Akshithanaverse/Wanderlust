<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Welcome Back!</h1>
    <div class="col-6 offset-3">
        <form method="POST" action="/login">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" placeholder="janedoe" type="text" class="form-control"
                    required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" placeholder="Enter your password" type="password" class="form-control"
                    required>
            </div>
            <button class="btn btn-success">Login</button>
        </form>
    </div>
    
</div>